<mujoco model="simple_biped">
    <compiler angle="degree"/>
    <option timestep="0.001"/>

    <visual>
        <global offwidth="1980" offheight="1080"/>
    </visual>

    <asset>
        <texture type="skybox" builtin="flat" rgb1="1 1 1" rgb2="1 1 1" width="32" height="32"/>
    </asset>

    <worldbody>

        <camera name="side_track" pos="0 -6 0.6" xyaxes="1 0 0 0 0 1" fovy="45"/>

        <!-- Torso -->
        <body name="torso" pos="0 0 -3.5">
            <geom type="capsule" size="0.1 0.3" mass="8" rgba="0.8 0.2 0.2 1"/>

            <!-- Free Joints-->
            <joint name="rootx" type="slide" axis="1 0 0"/>
            <joint name="rootz" type="slide" axis="0 0 1"/>
            <joint name="rooty" type="hinge" axis="0 1 0"/>
            
            <!-- Right arm -->
            <body name="right_upper_arm" pos="0 -0.15 0.25">
                <joint name="right_shoulder" type="hinge" axis="0 1 0" range="-90 90"/>
                <geom type="capsule" size="0.05 0.2" mass="0.5" rgba="0.8 0.5 0.2 1" pos="0 0 -0.2"/>
                <body name="right_forearm" pos="0 0 -0.4">
                    <joint name="right_elbow" type="hinge" axis="0 1 0" range="-120 0"/>
                    <geom name="right_forearm_geom" type="capsule" size="0.04 0.2" mass="0.4" rgba="0.8 0.5 0.2 1" pos="0 0 -0.2"/>
                    <site name="right_hand" pos="0 0 -0.44" size="0.02" rgba="1 0 0 1"/>
                </body>
            </body>

            <!-- Right thigh -->
            <body name="right_thigh" pos="0 -0.1 -0.3">
                <joint name="right_hip" type="hinge" axis="0 1 0" range="-60 60"/>
                <geom type="capsule" size="0.07 0.3" mass="1" rgba="0.2 0.2 0.8 1" pos="0 0 -0.3"/>
                <!-- Right shin -->
                <body name="right_shin" pos="0 0 -0.6">
                    <joint name="right_knee" type="hinge" axis="0 1 0" range="5 120"/>
                    <geom name="right_shin_geom" type="capsule" size="0.06 0.3" mass="1" rgba="0.2 0.2 0.8 1" pos="0 0 -0.3"/>
                    <!-- <site name="right_foot" pos="0 0 -0.66" size="0.02" rgba="0 1 0 1"/> -->
                    <!-- Right foot -->
                    <body name="right_foot" pos="0 0 -0.6">
                        <joint name="right_ankle" type="hinge" axis="0 1 0" range="-60 60"/>
                        <geom name="right_foot_geom" type="capsule" size="0.06 0.08" mass="0.1" rgba="0.2 0.2 0.8 1" pos="0 0 -0.0" euler="-0 90 0"
                        solref="0.001 1" solimp="0.99 0.99 0.001"/>
                    </body>
                </body>
            </body>            
        </body>
    </worldbody>

    <actuator>
        <motor joint="right_hip" ctrlrange="-200 200" forcerange="-200 200"/>
        <motor joint="right_knee" ctrlrange="-200 200" forcerange="-200 200"/>
        <!-- <motor joint="left_hip" ctrlrange="-200 200" forcerange="-200 200"/>
        <motor joint="left_knee" ctrlrange="-200 200" forcerange="-200 200"/> -->
        <motor joint="right_shoulder" ctrlrange="-100 100" forcerange="-100 100"/>
        <motor joint="right_elbow" ctrlrange="-100 100" forcerange="-100 100"/>
        <!-- <motor joint="left_shoulder" ctrlrange="-100 100" forcerange="-100 100"/>
        <motor joint="left_elbow" ctrlrange="-100 100" forcerange="-100 100"/> -->
    </actuator>
    
</mujoco>